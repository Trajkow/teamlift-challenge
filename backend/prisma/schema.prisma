generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Slot {
  id        String   @id @default(uuid()) @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz
  endsAt    DateTime @map("ends_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  booking   Booking?

  @@index([startsAt])
  @@map("slot")
}

model Booking {
  id                  String   @id @default(uuid()) @db.Uuid
  slotId              String   @unique @map("slot_id") @db.Uuid
  slot                Slot     @relation(fields: [slotId], references: [id], onDelete: Restrict)
  name                String
  email               String
  note                String?
  confirmationMessage String?  @map("confirmation_message") // Phase 3
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("booking")
}

/// The host's Google Calendar connection (Phase 7). A single row; the refresh token is stored encrypted.
model CalendarConnection {
  id                    String   @id @default("host")
  email                 String
  refreshTokenEncrypted String   @map("refresh_token_encrypted")
  needsReconnect        Boolean  @default(false) @map("needs_reconnect")
  connectedAt           DateTime @default(now()) @map("connected_at") @db.Timestamptz

  @@map("calendar_connection")
}
