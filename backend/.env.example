DATABASE_URL=postgresql://postgres:postgres@localhost:5433/slot_db
# Direct URL used for migrations (same as DATABASE_URL locally)
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/slot_db

PORT=3000
FRONTEND_ORIGIN=http://localhost:3001

APP_TIME_ZONE=Europe/Skopje
HOST_NAME=
# When set, /api/host/* and slot writes need the X-Host-Key header
HOST_KEY=

RATE_LIMIT_ENABLED=true

# Phase 3 (AI confirmation message)
GEMINI_API_KEY=
GEMINI_MODEL=

# Phase 6 (Google Calendar conflicts, optional: both needed)
GOOGLE_CALENDAR_ID=
# Service account key file contents, raw JSON or base64 (base64 -w0 key.json)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Phase 7 (host connects Google Calendar on /host, optional: all four needed)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# http://localhost:3001/api/host/calendar/callback locally, https://<vercel-domain>/api/host/calendar/callback live
GOOGLE_OAUTH_REDIRECT_URI=
# openssl rand -base64 32 (encrypts the stored refresh token)
CALENDAR_TOKEN_KEY=
